# Copy this file to `.env` and fill in the values. Never commit your real `.env`.

# Neon Postgres connection string (use the pooled URL).
# Neon Console → your project → Connection string.
DATABASE_URL=

# Neon Auth base URL. Neon Console → Auth.
NEON_AUTH_BASE_URL=

# Secret for signing session cookies — any random 32+ character string.
# Generate one with:  openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Admin email(s). Anyone signing in with a listed email gets admin access.
# Comma-separate for multiple admins:  me@example.com,editor@example.com
ADMIN_EMAIL=

# Vercel Blob read/write token (for photo uploads).
# Vercel → Storage → Blob → your store.
BLOB_READ_WRITE_TOKEN=
